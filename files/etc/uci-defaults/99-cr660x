#!/bin/sh
# 首次启动时执行：设置 LAN 地址、主机名、时区、默认中文界面、WiFi
uci set network.lan.ipaddr='192.168.6.1'
uci set network.lan.netmask='255.255.255.0'
uci commit network

uci set system.@system[0].hostname='CR660X'
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci commit system

uci set luci.main.lang='zh_cn'
uci commit luci

# 等待无线设备与默认接口初始化完成（避免 uci-defaults 竞态导致配置丢失并自删）
i=0
while [ "$i" -lt 15 ]; do
	if uci -q get wireless.radio0 >/dev/null 2>&1 && \
	   uci -q get wireless.radio1 >/dev/null 2>&1 && \
	   uci -q get wireless.default_radio0 >/dev/null 2>&1 && \
	   uci -q get wireless.default_radio1 >/dev/null 2>&1; then
		break
	fi
	/sbin/wifi config >/dev/null 2>&1
	if uci -q get wireless.radio0 >/dev/null 2>&1 && \
	   uci -q get wireless.radio1 >/dev/null 2>&1 && \
	   uci -q get wireless.default_radio0 >/dev/null 2>&1 && \
	   uci -q get wireless.default_radio1 >/dev/null 2>&1; then
		break
	fi
	sleep 1
	i=$((i + 1))
done

uci -q get wireless.radio0 >/dev/null 2>&1 && \
uci -q get wireless.radio1 >/dev/null 2>&1 && \
uci -q get wireless.default_radio0 >/dev/null 2>&1 && \
uci -q get wireless.default_radio1 >/dev/null 2>&1 || exit 1

# WiFi 配置：启用 2.4G + 5G
# radio0 = 2.4GHz, radio1 = 5GHz (mt7915e)
uci set wireless.radio0.disabled='0'
uci set wireless.radio0.country='US'
uci set wireless.radio0.band='2g'
uci set wireless.radio0.channel='6'
uci set wireless.radio0.band_steering='1'

uci set wireless.radio1.disabled='0'
uci set wireless.radio1.country='US'
uci set wireless.radio1.band='5g'
uci set wireless.radio1.channel='149'
uci set wireless.radio1.band_steering='1'

# === 开源 mt76 驱动调优参数（build-open.yml 版本生效）===
# 最大发射功率 (dBm)
uci set wireless.radio0.txpower='23'
uci set wireless.radio1.txpower='23'
# 启用 HE (802.11ax) BSS Coloring
uci set wireless.radio0.he_bss_color='1'
uci set wireless.radio1.he_bss_color='1'
# 启用 MU-MIMO Beamformer/Beamformee
uci set wireless.radio0.mu_beamformer='1'
uci set wireless.radio1.mu_beamformer='1'
uci set wireless.radio0.mu_beamformee='1'
uci set wireless.radio1.mu_beamformee='1'

# 默认 wifi-iface[0] 绑定 radio0，wifi-iface[1] 绑定 radio1
uci set wireless.default_radio0.disabled='0'
uci set wireless.default_radio0.ssid='cr660x'
uci set wireless.default_radio0.encryption='psk2+ccmp'
uci set wireless.default_radio0.key='12345678'
uci set wireless.default_radio0.network='lan'

uci set wireless.default_radio1.disabled='0'
uci set wireless.default_radio1.ssid='cr660x-5G'
uci set wireless.default_radio1.encryption='psk2+ccmp'
uci set wireless.default_radio1.key='12345678'
uci set wireless.default_radio1.network='lan'

uci commit wireless

exit 0
